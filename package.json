{
  "name": "dcc-members-oidf",
  "version": "1.0.0",
  "description": "## Description:",
  "main": "./lambda_function/issuer_registry.mjs",
  "scripts": {
    "generate-local-https-certs": "openssl req -nodes -new -x509 -keyout server.key -out server.crt -subj \"/CN=example.com/O=/C=US\" || echo 'OpenSSL not found, install it manually'",
    "build-local-db": "rm issuerreg.db; sqlite3 issuerreg.db < schema.sql",
    "load-local-test-data": "npm run builddb; sqlite3 issuerreg.db < testdata.sql",
    "load-remote-test-data": "python ./convert.py && aws dynamodb batch-write-item --request-items file://testdata.json",
    "start-local-web-service": "node ./lambda_function/issuer_registry.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.767.0",
    "aws-sdk": "^2.1692.0",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "newman": "^6.2.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "rimraf": "^5.0.1"
  }
}
